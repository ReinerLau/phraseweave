{
  "schema_version": 8,
  "max_units_per_anchor": 4096,
  "singleton_rules": [
    {
      "id": "nominal-singleton",
      "priority": 50,
      "when": {
        "pos": [
          "NOUN",
          "PROPN",
          "PRON",
          "NUM"
        ]
      }
    },
    {
      "id": "verb-singleton",
      "priority": 60,
      "when": {
        "pos": "VERB"
      }
    },
    {
      "id": "adjective-adverb-singleton",
      "priority": 50,
      "when": {
        "pos": [
          "ADJ",
          "ADV"
        ]
      }
    }
  ],
  "unit_rules": [
    {
      "id": "modifier-to-head",
      "anchor": {
        "dep": [
          "compound",
          "amod",
          "nummod"
        ],
        "pos": [
          "NOUN",
          "PROPN",
          "ADJ",
          "NUM"
        ]
      },
      "slots": [
        {
          "id": "head",
          "from": "anchor",
          "token": {
            "pos": [
              "NOUN",
              "PROPN",
              "ADJ",
              "NUM"
            ]
          },
          "required": true,
          "direction": "head"
        },
        {
          "id": "preposition",
          "from": "head",
          "token": {
            "pos": "ADP",
            "dep": "prep"
          },
          "required": false,
          "direction": "head"
        }
      ]
    },
    {
      "id": "object-through-preposition-to-head",
      "anchor": {
        "dep": [
          "pobj",
          "pcomp"
        ],
        "pos": [
          "NOUN",
          "PROPN",
          "PRON",
          "NUM"
        ]
      },
      "slots": [
        {
          "id": "preposition",
          "from": "anchor",
          "token": {
            "pos": "ADP",
            "dep": "prep"
          },
          "required": false,
          "direction": "head"
        }
      ]
    },
    {
      "id": "determiner-through-preposition-to-head",
      "anchor": {
        "dep": "det",
        "pos": "DET"
      },
      "slots": [
        {
          "id": "object",
          "from": "anchor",
          "token": {
            "pos": [
              "NOUN",
              "PROPN",
              "PRON",
              "NUM"
            ]
          },
          "required": true,
          "direction": "head"
        },
        {
          "id": "preposition",
          "from": "object",
          "token": {
            "pos": "ADP",
            "dep": "prep"
          },
          "required": false,
          "direction": "head"
        }
      ]
    },
    {
      "id": "possessor-through-preposition-to-head",
      "anchor": {
        "dep": "poss",
        "pos": [
          "PRON",
          "DET",
          "NOUN",
          "PROPN"
        ]
      },
      "slots": [
        {
          "id": "object",
          "from": "anchor",
          "token": {
            "pos": [
              "NOUN",
              "PROPN",
              "PRON"
            ]
          },
          "required": true,
          "direction": "head"
        },
        {
          "id": "preposition",
          "from": "object",
          "token": {
            "pos": "ADP",
            "dep": "prep"
          },
          "required": false,
          "direction": "head"
        }
      ]
    },
    {
      "id": "auxiliary-to-head",
      "anchor": {
        "dep": "aux",
        "pos": "AUX"
      },
      "slots": [
        {
          "id": "head",
          "from": "anchor",
          "token": {
            "pos": [
              "AUX",
              "VERB"
            ]
          },
          "required": true,
          "direction": "head"
        }
      ]
    },
    {
      "id": "adjective-complement-to-head",
      "anchor": {
        "dep": "acomp",
        "pos": [
          "ADJ",
          "NOUN"
        ]
      },
      "slots": [
        {
          "id": "head",
          "from": "anchor",
          "token": {
            "pos": [
              "AUX",
              "VERB"
            ]
          },
          "required": true,
          "direction": "head"
        }
      ]
    },
    {
      "id": "preposition-to-head-or-object",
      "anchor": {
        "dep": "prep",
        "pos": "ADP"
      },
      "slots": [
        {
          "id": "head",
          "from": "anchor",
          "token": {
            "pos": [
              "NOUN",
              "PROPN",
              "PRON",
              "NUM",
              "VERB"
            ],
            "dep": [
              "pobj",
              "pcomp"
            ]
          },
          "required": true,
          "direction": [
            "head",
            "child"
          ]
        },
        {
          "id": "determiner",
          "from": "head",
          "direction": "child",
          "token": {
            "pos": "DET",
            "dep": "det"
          },
          "required": false
        }
      ]
    }
  ]
}
