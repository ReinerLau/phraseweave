{
  "manifest_version": 3,
  "name": "PhraseWeave: Practice Selected Text",
  "version": "1.0.0",
  "key": "",
  "description": "Generate and practice learning units from text selected in a web page.",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "PhraseWeave：选中文字后右键导入"
  },
  "permissions": ["contextMenus", "notifications"],
  "background": {
    "service_worker": "service-worker.js"
  }
}
