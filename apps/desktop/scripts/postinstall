#!/bin/sh
set -eu

host_dir="/Library/Google/Chrome/NativeMessagingHosts"
host_manifest="$host_dir/com.phraseweave.capture.json"
host_binary="/Applications/PhraseWeave.app/Contents/Resources/native-host"

if [ ! -x "$host_binary" ]; then
  echo "PhraseWeave native host is missing from /Applications." >&2
  exit 1
fi

mkdir -p "$host_dir"
cat > "$host_manifest" <<'JSON'
{
  "name": "com.phraseweave.capture",
  "description": "Send selected text to PhraseWeave Desktop",
  "path": "/Applications/PhraseWeave.app/Contents/Resources/native-host",
  "type": "stdio",
  "allowed_origins": ["chrome-extension://mdjoodikmclnnbcdaiiiibihemokenjg/"]
}
JSON
chmod 644 "$host_manifest"

exit 0
